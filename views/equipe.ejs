<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Mon équipe</title>
    </head>
    <body>
        <h1>Voici mon équipe</h1>

        <% if(equipe.length > 0){ %>
            <% equipe.forEach(membre => { %>
                <div class="membre">
                    <h2><%= membre.prenom %> <%= membre.nom %></h2>
                    <p><%= membre.email %></p>
                </div>
            <% }) %>
        <% } else { %>
            <p>Aucun membre trouvé dans l'équipe.</p>
        <% } %>

        <img class="team-image" src="/images/photo-1740252117027-4275d3f84385"

    </body>
